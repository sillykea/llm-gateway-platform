{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits"],
  "labels": ["dependencies"],
  "schedule": ["before 6am on monday"],
  "packageRules": [
    {
      "description": "Group Terraform provider and module bumps into one PR",
      "matchManagers": ["terraform"],
      "groupName": "terraform"
    },
    {
      "description": "Never auto-merge major versions of platform charts",
      "matchDatasources": ["helm"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Chart versions pinned in YAML and Terraform, marked with a renovate comment",
      "fileMatch": ["^gitops/apps/values\\.yaml$", "^terraform/stacks/platform/variables\\.tf$"],
      "matchStrings": [
        "#\\s*renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) registryUrl=(?<registryUrl>\\S+)\\s*\\n\\s*\\S+\\s*[:=]\\s*\"?(?<currentValue>[^\"\\s]+)\"?"
      ]
    }
  ]
}

# After the first apply, rename to backend.tf and run:
#   terraform init -migrate-state
terraform {
  backend "s3" {
    bucket       = "llm-gateway-tfstate-<your-account-id>"
    key          = "bootstrap/terraform.tfstate"
    region       = "ap-southeast-2"
    encrypt      = true
    use_lockfile = true
  }
}
